generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum LessonStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MemoryType {
  MISCONCEPTION
  WEAKNESS
  STRENGTH
  PREFERENCE
  LEARNING_NOTE
}

enum AiOperation {
  COURSE_GENERATION
  LESSON_GENERATION
  TUTOR
  MEMORY_EXTRACTION
  EMBEDDING
  QUIZ_GENERATION
}

enum AiRequestStatus {
  SUCCESS
  ERROR
}

enum ExerciseType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTIPLE_SELECT
  MATCHING
  ORDERING
}

enum AttemptResult {
  CORRECT
  INCORRECT
}

enum GenerationKind {
  LESSON_CONTENT
  LESSON_QUIZ
}

enum GenerationStatus {
  NOT_STARTED
  GENERATING
  READY
  FAILED
}

enum LearningEventType {
  LESSON_STARTED
  LESSON_COMPLETED
  QUIZ_COMPLETED
}

enum RegenerationTarget {
  LESSON_CONTENT
  LESSON_QUIZ
  CURRICULUM
  MODULE
}

enum CurriculumRevisionScope {
  COURSE
  MODULE
}

enum CurriculumRevisionStatus {
  DRAFT
  APPLIED
}

model Course {
  id           String       @id @default(cuid())
  ownerId      String       @db.Uuid
  title        String
  description  String?
  goal         String
  status       CourseStatus @default(DRAFT)
  prompt       String
  instructions String?

  modules         Module[]
  courseMemories  CourseMemory[]
  templates       CourseTemplate[]
  learningEvents       LearningEvent[]
  studyTime            StudyTime[]
  curriculumRevisions  CurriculumRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  objective   String?
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons              Lesson[]
  curriculumRevisions  CurriculumRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  objectives  String[]
  concepts    String[]
  order       Int
  status      LessonStatus @default(LOCKED)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  content         LessonContent?
  conversations   Conversation[]
  courseMemories  CourseMemory[]
  exercises       Exercise[]
  generationJobs  GenerationJob[]
  quizRuns         QuizRun[]
  learningEvents   LearningEvent[]
  studyTime        StudyTime[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([moduleId, order])
  @@index([moduleId])
}

model LessonContent {
  id String @id @default(cuid())

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  content           Json
  generationVersion Int      @default(1)
  generatedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LessonContentVersion {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation("LessonContentVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  activeFor Lesson? @relation("ActiveLessonContentVersion")

  version      Int
  content      Json
  instructions String?
  createdAt    DateTime @default(now())

  @@unique([lessonId, version])
  @@index([lessonId, createdAt])
}

model Conversation {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model Message {
  id      String      @id @default(cuid())
  role    MessageRole
  content String

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CourseMemory {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  type       MemoryType
  content    String
  importance Int        @default(3)
  embedding  Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([lessonId])
  @@index([courseId, type])
}

model AiUsage {
  id     String @id @default(cuid())
  userId String @db.Uuid

  operation AiOperation
  status    AiRequestStatus
  model     String

  providerResponseId String?
  input              Json?
  output             String?

  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?
  reasoningTokens   Int?
  durationMs        Int?
  errorMessage      String?

  courseId       String?
  lessonId       String?
  conversationId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([operation, createdAt])
  @@index([model, createdAt])
  @@index([courseId, createdAt])
  @@index([lessonId, createdAt])
}

model Exercise {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  quizVersionId String
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id], onDelete: Cascade)

  type        ExerciseType
  order       Int
  question    String
  data        Json
  answerKey   Json
  explanation String
  concepts    String[]
  attempts    ExerciseAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizVersionId, order])
  @@index([lessonId])
  @@index([quizVersionId])
}

model ExerciseAttempt {
  id String @id @default(cuid())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  quizRunId String
  quizRun   QuizRun @relation(fields: [quizRunId], references: [id], onDelete: Cascade)

  answer Json
  result AttemptResult

  createdAt DateTime @default(now())

  @@index([exerciseId, createdAt])
  @@index([quizRunId, createdAt])
}

model QuizRun {
  id String @id @default(cuid())
  userId String @db.Uuid

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  quizVersionId String
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)

  attempts ExerciseAttempt[]

  score Int?
  total Int?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId, startedAt])
  @@index([lessonId, startedAt])
  @@index([quizVersionId, startedAt])
}

model QuizVersion {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation("LessonQuizVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  activeFor Lesson? @relation("ActiveLessonQuizVersion")

  version      Int
  instructions String?
  exercises    Exercise[]
  quizRuns     QuizRun[]
  createdAt    DateTime @default(now())

  @@unique([lessonId, version])
  @@index([lessonId, createdAt])
}

model LearningEvent {
  id String @id @default(cuid())
  userId String @db.Uuid

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  type     LearningEventType
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([lessonId, createdAt])
}

model StudyTime {
  id String @id @default(cuid())
  userId String @db.Uuid

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  day     DateTime @db.Date
  seconds Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, day])
  @@index([userId, day])
  @@index([courseId, day])
}

model AiRequestWindow {
  id          String      @id @default(cuid())
  scopeKey    String
  operation   AiOperation
  windowStart DateTime
  count       Int         @default(0)

  @@unique([scopeKey, operation, windowStart])
  @@index([windowStart])
}

model UserPrivacySettings {
  userId          String   @id @db.Uuid
  storeAiPayloads Boolean  @default(false)
  retentionDays   Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GenerationJob {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  kind       GenerationKind
  status     GenerationStatus @default(NOT_STARTED)
  claimToken String?

  attemptCount Int @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, kind])
  @@index([status, updatedAt])
}


model CourseTemplate {
  id             String   @id @default(cuid())
  ownerId        String   @db.Uuid
  sourceCourseId String?
  sourceCourse   Course?  @relation(fields: [sourceCourseId], references: [id], onDelete: SetNull)

  name        String
  description String?
  structure   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([sourceCourseId])
}


model RegenerationLock {
  id String @id @default(cuid())
  ownerId String @db.Uuid

  target   RegenerationTarget
  targetId String
  status   GenerationStatus @default(NOT_STARTED)

  claimToken   String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([target, targetId])
  @@index([ownerId, updatedAt])
}

model CurriculumRevision {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  scope        CurriculumRevisionScope
  version      Int
  status       CurriculumRevisionStatus @default(DRAFT)
  instructions String?
  structure    Json

  createdAt DateTime @default(now())
  appliedAt DateTime?

  @@index([courseId, createdAt])
  @@index([moduleId, createdAt])
  @@index([courseId, scope, version])
}
